# Copy this file to .env.local for local work:   cp .env.example .env.local
# On Cloudflare Pages add the same names under: Settings > Variables and secrets.
#
# IMPORTANT: every NEXT_PUBLIC_* value is copied into the public website files
# at BUILD time. Never put a real secret (passwords, private API keys) here.
# After changing a value on Cloudflare you must trigger a new deployment.

# Final public address of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact details shown on the site.
NEXT_PUBLIC_PHONE=+91 98765 43210
# WhatsApp number: country code + number, digits only (no + or spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_EMAIL=hello@example.com

# Enquiry form: choose ONE provider: "web3forms" or "formspree".
NEXT_PUBLIC_FORM_PROVIDER=web3forms
# Web3Forms: access key from https://web3forms.com (it is designed to be public).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# Formspree: full endpoint of your form, e.g. https://formspree.io/f/abcdwxyz
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
